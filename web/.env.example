# העתקה של המשתנים שצריך להגדיר ב-Vercel.
# אין להעתיק לכאן ערכים אמיתיים ואין להעלות קובץ .env למאגר.

# ── מתג העלייה לאוויר ─────────────────────────────────────────
# כל עוד לא מוגדר, האתר חסום לחלוטין מגוגל.
# ביום המעבר בלבד: NEXT_PUBLIC_SITE_LIVE=true
NEXT_PUBLIC_SITE_LIVE=

# ── יעד הלידים ────────────────────────────────────────────────
# מספיק להגדיר אחד מהשניים. אם שניהם מוגדרים, הליד נשלח לשניהם.

# אפשרות א׳ (מומלצת): Webhook.
# מקבל JSON ומאפשר לנתב לוואטסאפ, למייל או ל-CRM דרך Make או Zapier
# בלי לגעת בקוד.
LEAD_WEBHOOK_URL=

# אפשרות ב׳: מייל דרך Resend.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# ── מקור המלאי ────────────────────────────────────────────────
# אם ריק, האתר מושך מהמערכת הקיימת.
# להעברת המלאי למערכת אחרת (CRM) — למלא כאן, בלי שינוי בקוד.
VEHICLES_API_URL=
VEHICLE_IMAGES_XML_URL=
VEHICLES_API_TOKEN=

# ── אזור אישי והתראות ──────────────────────────────
# מפתח לחתימת עוגיית הכניסה. מחרוזת אקראית ארוכה, סוד.
AUTH_SECRET=

# אחסון החשבונות. בלי אלה הנתונים נשמרים בזיכרון בלבד ונמחקים
# בכל פריסה — חובה להגדיר לפני שהאתר עולה לאוויר.
# נפתח בחינם ב-upstash.com, מוצר Redis, ומעתיקים משם את שני הערכים.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# שליחת הודעות — קוד כניסה והתראות על רכבים.
# כתובת שמקבלת POST עם {phone, text}. אפשר ספק SMS ישיר או Make/Zapier.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# סוד להרצת סריקת ההתראות. מוגדר גם ב-Vercel Cron.
CRON_SECRET=
